Vagrant.configure("2") do |config|
  # El laboratorio se administra desde este Vagrantfile. La carpeta /vagrant
  # por defecto no se necesita en los nodos objetivo.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Control Node
  config.vm.define "ansible-control" do |node|
    node.vm.box = "bento/ubuntu-24.04"
    node.vm.box_version = "202510.26.0"
    node.vm.hostname = "ansible-control"
    node.vm.network "private_network", ip: "192.168.56.10"
    # El código Ansible solo se comparte con el nodo de control.
    node.vm.synced_folder "../../ansible", "/home/vagrant/ansible",
      owner: "vagrant",
      group: "vagrant",
      mount_options: ["dmode=755,fmode=755"]
    node.vm.provider "virtualbox" do |vb|
      vb.name = "lab-ansible-control"
      vb.memory = 2048
      vb.cpus = 2
    end
  end

  # Debian 12
  config.vm.define "debian12" do |node|
    node.vm.box = "bento/debian-12"
    node.vm.box_version = "202510.26.0"
    node.vm.hostname = "debian12"
    node.vm.network "private_network", ip: "192.168.56.11"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "lab-debian12"
      vb.memory = 2048
      vb.cpus = 2
    end
  end

  # Ubuntu 24
  config.vm.define "ubuntu24" do |node|
    node.vm.box = "bento/ubuntu-24.04"
    node.vm.box_version = "202510.26.0"
    node.vm.hostname = "ubuntu24"
    node.vm.network "private_network", ip: "192.168.56.12"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "lab-ubuntu24"
      vb.memory = 2048
      vb.cpus = 2
    end
  end
end
