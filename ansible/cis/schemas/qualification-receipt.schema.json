{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cis:qualification-receipt:v1",
  "type": "object",
  "required": ["schema_version", "receipt_id", "schema_digest", "request_digest", "catalog_digest", "ledger_digest", "semantic_review_digest", "candidate_digest", "coverage_mode", "coverage_target", "profile_identity", "aggregate"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ledger_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semantic_review_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "coverage_mode": {"enum": ["exhaustive", "pilot"]},
    "coverage_target": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "required": ["platform", "version", "control"], "additionalProperties": false,
        "properties": {
          "platform": {"type": "string", "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"},
          "version": {"type": "string", "pattern": "^[0-9][0-9.]*$"},
          "control": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
        }
      }
    },
    "profile_identity": {
      "type": "object",
      "required": ["platform", "version", "profile", "membership_scope"],
      "additionalProperties": false,
      "properties": {
        "platform": {"type": "string", "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"},
        "version": {"type": "string", "pattern": "^[0-9][0-9.]*$"},
        "profile": {"enum": ["level_1_server", "level_2_server", "level_1_workstation", "level_2_workstation"]},
        "membership_scope": {"enum": ["raw", "expanded"]}
      }
    },
    "aggregate": {
      "type": "object",
      "required": ["selected", "automated", "manual", "na", "gated_unsafe", "unsupported", "passed", "failed", "status"],
      "additionalProperties": false,
      "properties": {
        "selected": {"type": "integer", "minimum": 0},
        "automated": {"type": "integer", "minimum": 0},
        "manual": {"type": "integer", "minimum": 0},
        "na": {"type": "integer", "minimum": 0},
        "gated_unsafe": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "status": {"enum": ["qualified", "blocked"]}
      }
    }
  }
}
