{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cis:control-ledger:v1",
  "type": "object",
  "required": ["schema_version", "ledger_id", "catalog_digest", "controls"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "ledger_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "controls": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "version", "control", "memberships", "disposition", "applicability", "route"],
        "additionalProperties": false,
        "properties": {
          "platform": {"type": "string", "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"},
          "version": {"type": "string", "pattern": "^[0-9][0-9.]*$"},
          "control": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "memberships": {
            "type": "object", "required": ["raw", "expanded"], "additionalProperties": false,
            "properties": {
              "raw": {"type": "array", "uniqueItems": true, "items": {"enum": ["level_1_server", "level_2_server", "level_1_workstation", "level_2_workstation"]}},
              "expanded": {"type": "array", "uniqueItems": true, "items": {"enum": ["level_1_server", "level_2_server", "level_1_workstation", "level_2_workstation"]}}
            }
          },
          "disposition": {"enum": ["automated", "manual", "na", "gated_unsafe", "unsupported"]},
          "applicability": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
          "route": {
            "type": "object", "required": ["mode", "route_owner", "backend", "route_class"], "additionalProperties": false,
            "properties": {
              "mode": {"enum": ["audit", "remediation", "verification"]},
              "route_owner": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
              "backend": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
              "route_class": {"enum": ["legacy", "new"]}
            }
          }
        }
      }
    }
  }
}
