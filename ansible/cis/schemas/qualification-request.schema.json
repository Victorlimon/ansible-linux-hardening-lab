{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cis:qualification-request:v1",
  "type": "object",
  "required": ["schema_version", "request_id", "schema_digest", "catalog_digest", "ledger_digest", "semantic_review_digest", "candidate_digest", "platform", "version", "profile", "membership_scope"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ledger_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semantic_review_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "platform": {"type": "string", "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9][0-9.]*$"},
    "profile": {"enum": ["level_1_server", "level_2_server", "level_1_workstation", "level_2_workstation"]},
    "membership_scope": {"enum": ["raw", "expanded"]},
    "coverage_mode": {"enum": ["exhaustive", "pilot"]},
    "coverage_target": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "required": ["platform", "version", "control"], "additionalProperties": false,
        "properties": {
          "platform": {"type": "string", "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"},
          "version": {"type": "string", "pattern": "^[0-9][0-9.]*$"},
          "control": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
        }
      }
    }
  }
}
